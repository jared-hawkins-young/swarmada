# LiteLLM proxy config for local dev.
#
# Copy this file to config/litellm-local.yaml and fill in the {{ ... }}
# placeholders (or set the env vars and use `envsubst`). NEVER commit the
# populated copy — the .gitignore blocks *.yaml except *.example.yaml.

model_list:
  # Local dev routes: names match what's actually serving requests.
  # Prod would replace these with real Anthropic / OpenAI / etc. routes
  # under whatever client-facing names prod wants (e.g.
  # anthropic/claude-3.5-sonnet); the sidecar's SIDECAR_ACTIVE_MODEL
  # env var switches between them.

  - model_name: local/llama3.2:1b
    litellm_params:
      model: ollama/llama3.2:1b
      api_base: http://localhost:11434

  # Real LlamaGuard 3 1B via ollama. Pull once with:
  #   ollama pull llama-guard3:1b
  # Returns "safe" for benign input; "unsafe\n<category>" (e.g. "S2" =
  # Non-Violent Crimes) for policy violations. Prod may swap this for
  # the larger meta-llama/Llama-Guard-3-8B (via ollama or a hosted
  # backend) by editing this route — no sidecar code change.
  - model_name: local/llamaguard
    litellm_params:
      model: ollama/llama-guard3:1b
      api_base: http://localhost:11434

litellm_settings:
  drop_params: true
  # Use `langfuse_otel` — the OTel-based callback compatible with Langfuse
  # SDK 4.x. The old `langfuse` callback expects langfuse 2.x and errors
  # out on the newer SDK, which is why model/token/cost data never landed.
  success_callback: ["langfuse_otel"]
  failure_callback: ["langfuse_otel"]

general_settings:
  telemetry: false
  master_key: "{{ LITELLM_MASTER_KEY }}"
  ui_access_mode: "admin_only"

environment_variables:
  LANGFUSE_HOST: "{{ LANGFUSE_HOST }}"
  LANGFUSE_PUBLIC_KEY: "{{ LANGFUSE_PUBLIC_KEY }}"
  LANGFUSE_SECRET_KEY: "{{ LANGFUSE_SECRET_KEY }}"
